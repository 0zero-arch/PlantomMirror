# PhantomMirror 后端配置模板
#
# 用法：cp .env.example .env  然后填上真实密码。
# .env 已在 .gitignore 里，不要提交。
#
# 同一份文件同时驱动 docker-compose（读 *_PASSWORD / *_USER / *_PORT）
# 和 NestJS 应用（读 DATABASE_URL / REDIS_* / S3_*）。
# 密码只需在一处维护，避免两边不一致。

# ---------- 运行环境 ----------
NODE_ENV=development
PORT=3000
# 对外可见的 API 前缀，客户端 ApiEndpoints 需与此保持一致
API_PREFIX=api/v1

# ---------- PostgreSQL ----------
POSTGRES_USER=phantommirror
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=phantommirror
# 宿主机端口（服务器上已有原生 PG 占用 5432，故用 5433）
POSTGRES_PORT=5433
# 127.0.0.1 = 只允许本机/SSH 隧道访问；0.0.0.0 = 对公网开放（需云安全组放行）
POSTGRES_BIND=127.0.0.1
# 应用侧连接串。本地开发时先建立 SSH 隧道，见下方「本地开发」注释。
DATABASE_URL=postgresql://phantommirror:change-me-postgres@127.0.0.1:5433/phantommirror?schema=public

# ---------- Redis（BullMQ 队列）----------
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6380
REDIS_BIND=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_DB=0

# ---------- MinIO（S3 兼容对象存储）----------
MINIO_ROOT_USER=phantommirror
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BIND=127.0.0.1

# 应用侧 S3 参数
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=phantommirror
S3_SECRET_KEY=change-me-minio
S3_BUCKET=phantommirror
S3_FORCE_PATH_STYLE=true
# 预签名 URL 里写死的主机名。手机/浏览器必须能直接访问它。
# 本地开发用 127.0.0.1；若 API 部署在服务器上供真机联调，改成 http://101.35.163.174:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# 预签名 URL 有效期（秒）
S3_PRESIGN_EXPIRES=900

# ---------- AI Provider ----------
# mock | perfect-corp | gemini
AI_PROVIDER=mock
# 真实 Provider 的 Key，Phase 1 留空
PERFECT_CORP_API_KEY=
GEMINI_API_KEY=

# ---------- 其他 ----------
# 允许跨域的来源，逗号分隔；* 仅限开发
CORS_ORIGIN=*

# ---------------------------------------------------------------
# 本地开发：先建立 SSH 隧道把服务器的存储层映射到本机
#
#   ssh -N -L 5433:127.0.0.1:5433 \
#          -L 6380:127.0.0.1:6380 \
#          -L 9000:127.0.0.1:9000 \
#          -L 9901:127.0.0.1:9001 ubuntu@101.35.163.174
#
# 这样本机就能用上面的 127.0.0.1 连接串直连服务器上的容器，
# 且这几个端口不需要在腾讯云安全组里对公网开放。
#
# ⚠️ 控制台映射到本机 9901 而不是 9001：Windows 上本机 9001 已被某个
#    svchost 服务占用，绑定会报 WinError 10013。
#    控制台地址：http://127.0.0.1:9901
# ---------------------------------------------------------------