# 依赖
node_modules/

# Prisma 生成的客户端：由 `prisma generate`（postinstall / build）重建，不入库
src/generated/

# 构建产物
dist/
build/
*.tsbuildinfo

# 环境变量：含数据库 / Redis / MinIO 密码，绝不入库
.env
.env.*
!.env.example

# 测试与覆盖率
coverage/
.nyc_output/
*.lcov

# 日志
*.log
npm-debug.log*
logs/

# Python 字节码（scripts/ 下的运维脚本用）
__pycache__/
*.py[cod]

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db